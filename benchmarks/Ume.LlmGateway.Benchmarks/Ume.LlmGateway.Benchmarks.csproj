<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <!-- BenchmarkDotNet needs public, non-sealed benchmark classes and instance methods. -->
    <NoWarn>$(NoWarn);CA1001;CA1707;CA1515;CA1812;CA1852;CA2000;CA5394;CA1861;CA2234</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Redis" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Ume.LlmGateway.Gateway\Ume.LlmGateway.Gateway.csproj" />
  </ItemGroup>
</Project>
