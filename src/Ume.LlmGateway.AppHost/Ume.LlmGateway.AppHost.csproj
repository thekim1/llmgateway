    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>ume-llm-gateway-apphost-dev</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Docker" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.Redis" />
    <PackageReference Include="Aspire.Hosting.Keycloak" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Ollama" />
  </ItemGroup>
  <ItemGroup>
    <!-- Health endpoint paths, shared with the services without referencing ServiceDefaults (the type is internal on both sides). -->
    <Compile Include="..\Ume.LlmGateway.ServiceDefaults\HealthEndpoints.cs" Link="HealthEndpoints.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ume.LlmGateway.AdminApi\Ume.LlmGateway.AdminApi.csproj" />
    <ProjectReference Include="..\Ume.LlmGateway.DataApi\Ume.LlmGateway.DataApi.csproj" />
    <ProjectReference Include="..\Ume.LlmGateway.FakeLlm\Ume.LlmGateway.FakeLlm.csproj" />
    <ProjectReference Include="..\Ume.LlmGateway.Gateway\Ume.LlmGateway.Gateway.csproj" />
    <ProjectReference Include="..\Ume.LlmGateway.MigrationService\Ume.LlmGateway.MigrationService.csproj" />
  </ItemGroup>
</Project>
