# nginx in front of the gateway (re-encrypting to the HTTPS upstreams).
# deploy/init-deployment.sh --proxy fills in the @placeholders@ and writes proxy/nginx.conf.
# Add your own ssl_certificate / ssl_certificate_key (from your PKI or Let's Encrypt).
# Pass the Host header through unchanged: the admin UI builds its OIDC redirect URIs from it.

# WebSocket upgrade for live audio (/v1/realtime); other requests keep the pooled keep-alive connection.
map $http_upgrade $ume_connection { default upgrade; '' ''; }

# With compose.rolling.yaml (init-deployment.sh --rolling) each service has a second slot; nginx sends requests to
# both and retries on the other when one fails while it is replaced (proxy_next_upstream below).
# See docs/zero-downtime-updates.md.
upstream ume_gateway {
    server @UPSTREAM@:@GATEWAY_PORT@;
    #rolling server @UPSTREAM@:@GATEWAY_B_PORT@;
    keepalive 32;
}
upstream ume_admin {
    server @UPSTREAM@:@ADMIN_PORT@;
    #rolling server @UPSTREAM@:@ADMIN_B_PORT@;
}

server {
    listen 443 ssl;
    http2 on;
    server_name @GATEWAY_HOST@;
    # ssl_certificate     /etc/ssl/@GATEWAY_HOST@.crt;
    # ssl_certificate_key /etc/ssl/@GATEWAY_HOST@.key;

    client_max_body_size 32m;          # prompts with documents/images, audio uploads (gateway default 26 MB)
    location / {
        proxy_pass https://ume_gateway;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;  # live audio sessions (WebSocket)
        proxy_set_header Connection $ume_connection;
        proxy_set_header Host $host;
        # The client's address, for keys restricted to client addresses. List this proxy under
        # Settings > Trusted proxies in the admin UI, or the gateway ignores the header.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;           # stream tokens as they arrive (SSE)
        proxy_request_buffering off;   # pass uploads straight through: no recordings in proxy temp files
        proxy_read_timeout 600s;       # long generations; live sessions stay open through the gateway's 30 s pings
        proxy_send_timeout 600s;
        # Retry on the other slot when a connection fails before any response, also for POST (non_idempotent): a slot
        # being replaced resets connections it accepted but never read, so the request did not run. Only within 10 s,
        # so a request that ran long and then failed is never repeated.
        proxy_next_upstream error timeout non_idempotent;
        proxy_next_upstream_timeout 10s;
        proxy_next_upstream_tries 2;
        proxy_connect_timeout 5s;
        # The upstream presents the internal CA's certificate. To verify it, copy
        # certs/ca.pem to the proxy and enable:
        # proxy_ssl_verify on; proxy_ssl_trusted_certificate /etc/ssl/ume-internal-ca.pem;
        # proxy_ssl_name gateway;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name @ADMIN_HOST@;
    # ssl_certificate     /etc/ssl/@ADMIN_HOST@.crt;
    # ssl_certificate_key /etc/ssl/@ADMIN_HOST@.key;

    location / {
        proxy_pass https://ume_admin;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;  # shown on the Settings page to identify this proxy
        proxy_next_upstream error timeout non_idempotent;  # as for the gateway
        proxy_next_upstream_timeout 10s;
        proxy_next_upstream_tries 2;
        proxy_connect_timeout 5s;
        # proxy_ssl_verify on; proxy_ssl_trusted_certificate /etc/ssl/ume-internal-ca.pem;
        # proxy_ssl_name adminapi;
    }
}
