<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Every project here is a test project except the shared test kit, a library the test projects reference. -->
    <IsTestProject Condition="'$(MSBuildProjectName)' != 'Ume.LlmGateway.TestKit'">true</IsTestProject>
    <OutputType Condition="'$(IsTestProject)' == 'true'">Exe</OutputType>
    <NoWarn>$(NoWarn);CA1707;CA1515;CA2000;CA1861;CA1001;CA1063;CA1816;CA2234;CA1812;CA2201;CA1849</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>
</Project>
