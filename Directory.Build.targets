<Project>
  <!--
    Container settings shared by the service images (AdminApi, DataApi, Gateway, MigrationService). Opt in with
    <UmeServiceContainer>true</UmeServiceContainer>. This lives in a .targets file because Directory.Build.props is read
    before the project file, so it cannot see the opt-in; the SDK reads these properties in targets that run later.
    Base image: digest-pinned chiseled-extra (non-root, no shell, ICU and time-zone data). Update tag and digest together.
  -->
  <PropertyGroup Condition="'$(UmeServiceContainer)' == 'true'">
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0.14-noble-chiseled-extra@sha256:9b755ea799ae649141a073e30d8b62d8095a5465af2b7694d17866e8c05131d8</ContainerBaseImage>
    <ContainerUser>1654</ContainerUser>
  </PropertyGroup>
</Project>
