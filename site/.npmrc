# Supply-chain hardening (docs/security-and-compliance.md, "npm packages").
# No package may run code when it is installed; none of ours need to (npm run/test still work).
ignore-scripts=true
# Adding or updating a package skips versions younger than 7 days, when hijacked releases are usually caught and
# pulled. npm ci installs exactly what package-lock.json says and is not affected.
min-release-age=7
# Only registry packages, never dependencies fetched straight from git.
allow-git=none
